# Secretos para ejecución LOCAL (sin Docker). En Docker usa ./secrets (scripts/init-secrets.sh).
# Copia a .env (está en .gitignore) y rellena. Nunca subas .env a git.

# Base de datos (SQLite para empezar; PostgreSQL recomendado en producción)
DATABASE_URL=sqlite+aiosqlite:///./data/copytrader.db
# DATABASE_URL=postgresql+asyncpg://copytrader:PASSWORD@localhost:5432/copytrader

# RPC de Solana con tu API key (Helius, QuickNode, Triton...)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=XXXX
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=XXXX
# JUPITER_API_KEY=
# Velocidad (opcionales): stream de respaldo de OTRO proveedor, RPC extra de envío y clave de Jito
# SOLANA_WS_URL_BACKUP=wss://otro-proveedor.example/?api-key=XXXX   # con providers.solana.backup_stream
# SOLANA_SEND_RPC_URLS=https://sender.example/?api-key=XXXX,https://otro.example/?api-key=YYYY
# JITO_AUTH_UUID=               # x-jito-auth: límites de envío más altos en el block engine

# Notificaciones
# TELEGRAM_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=

# Firmador (dinero real). Genera con: copytrader gen-secret
# SIGNER_HMAC_KEY=
# KEYSTORE_PASSPHRASE=          # solo con security.signer_mode: local
# DATA_ENCRYPTION_KEY=          # necesario para TOTP

# Cada variable admite la forma *_FILE=/ruta/al/fichero (Docker/K8s secrets)
